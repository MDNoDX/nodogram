# Nodik Watcher configuration. Copy to .env (same folder) and fill in.
# chmod 600 .env   — the session string gives FULL access to your account.
# NEVER commit .env (it is gitignored).

# --- MTProto app credentials (from https://my.telegram.org → API dev tools) ---
API_ID=1234567
API_HASH=your-api-hash-here

# --- Your account session (produced by `node login.mjs`; keep it SECRET) ---
MTPROTO_SESSION=

# --- Where to report (the same bot + channel the vault uses) ---
BOT_TOKEN=123456:your-bot-token
LOG_CHANNEL=-1004307378178

# --- Options ---
# 1 = also report every incoming private message (noisier). 0 = only "tried to type".
REPORT_MESSAGES=0
# Timezone for timestamps.
TZ=Asia/Tashkent
