# Nodogram Vault / Nodik bot — configuration template.
# Copy to ~/Library/Application Support/Nodogram/vault.env and fill in.
# NEVER commit the real vault.env (it is gitignored). chmod 600 it.

# --- Telegram bot (from @BotFather) ---
BOT_TOKEN=123456:your-bot-token-here
OWNER_ID=1255719279                 # only this Telegram user may use the bot

# --- Local API (the app <-> vault bridge; loopback only) ---
VAULT_API_TOKEN=generate-a-long-random-string
VAULT_PORT=47823

# --- Private log channel the bot archives to (bot must be admin) ---
LOG_CHANNEL=-1004307378178

# --- Gemini AI (Nodik) ---
# Either point to a key file (one key per line), or list keys inline here.
# Each free key is ~20 requests/day on the newest model; add several to rotate.
GEMINI_KEY_FILE=/Users/you/Library/Application Support/Nodogram/gemini.key
# GEMINI_KEY=key1,key2,key3          # alternative: inline, comma-separated

# --- PostgreSQL (Postgres.app) ---
DATABASE_URL=postgres://you@127.0.0.1:5432/nodogram_vault
